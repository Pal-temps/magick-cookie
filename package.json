{
  "name": "do-it-now",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "predev": "node scripts/kill-existing.js",
    "dev": "node scripts/ensure-db.js && bun run db:migrate && concurrently -n api,desktop -c blue,green \"bun run api:dev\" \"bun run desktop:dev\"",
    "api:dev": "bun run --filter api dev",
    "desktop:dev": "bun run --filter desktop tauri:dev",
    "db:migrate": "bun run --filter api db:migrate",
    "db:generate": "bun run --filter api db:generate",
    "db:studio": "bun run --filter api db:studio",
    "test": "bun run --filter api test",
    "test:integration": "bun run --filter api test:integration",
    "test:e2e": "bun run --filter api test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
