{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "magick-cookie",
  "version": "0.1.0",
  "identifier": "com.bumblelab.magick-cookie",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:47420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magick Cookie",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: tauri: https: http:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost https://ipc.localhost http://localhost:* https: ws://localhost:* wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["French", "English"],
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsi"
      }
    }
  }
}
