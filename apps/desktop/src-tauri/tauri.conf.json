{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "magick-cookie",
  "version": "0.1.0",
  "identifier": "com.bumblelab.do-it-now",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:47420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magick Cookie",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "decorations": false,
        "icon": "icons/icon.png"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
