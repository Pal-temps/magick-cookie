PORT=47300
DATABASE_URL=postgres://postgres:postgres@localhost:47532/magick_cookie
CLICKUP_API_TOKEN=pk_your_token_here

# Bearer token that callers must pass as `Authorization: Bearer <token>` on every /api/* request.
# Leave EMPTY only when the API is bound exclusively to loopback (local Tauri usage).
# REQUIRED in any deployed/exposed environment — without it every route is publicly reachable.
API_AUTH_TOKEN=

# Comma-separated list of browser origins allowed to hit /api/*. Leave empty to keep the
# safe default (local Tauri dev URL). Requests with no Origin header (native fetch, curl)
# are always accepted.
CORS_ORIGINS=
